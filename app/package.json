{
  "name": "agent-character-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Stoa: where teams of AI agents are designed, not assembled.",
  "scripts": {
    "gen-data": "tsx scripts/gen-data.ts",
    "predev": "npm run gen-data",
